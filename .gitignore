# 환경변수
.env
.env.local
*.env

# Node
node_modules/
.expo/
dist/

# Python
__pycache__/
*.pyc
.venv/
venv/

# EAS
.eas/

# OS
.DS_Store
Thumbs.db

# Wrangler cache
.wrangler/

# 애플 API 키·안드로이드 업로드 키스토어 (절대 커밋 금지)
app/certs/

# 인스타그램 로그인 세션(쿠키) — 비밀번호와 동급, 절대 커밋 금지
crawler/.instagram_session.json
crawler/.ig_chrome_profile/

# supabase CLI 로컬 캐시(link 시 생성, 프로젝트 무관 기기별 값)
supabase/.temp/

# 크롤러 로컬 검증용 가상환경(스크래퍼를 DB 없이 돌려보는 용도)
crawler/.venv/

# Claude Code 개인 설정(허락 없이는 작업 시작 못하게 하는 권한 게이트 등) — 개인용, 커밋 안 함
.claude/settings.local.json

# EAS 로컬 자격증명 — 배포 인증서 경로·비밀번호가 들어간다. 절대 커밋 금지.
app/credentials.json

# 스토어 제출용 빌드 산출물 — 100MB 넘어서 GitHub 이 거부한다(2026-09-01).
# 필요하면 EAS 에서 다시 받는다.
docs/store-assets/*.aab
docs/store-assets/*.ipa

# 자체 OTA 배포 시 생기는 임시 내보내기 폴더
app/.ota-export/
