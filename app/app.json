{
  "expo": {
    "name": "소개팅모아",
    "slug": "sodate",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "_comment_backgroundColor": "네이티브 창/루트뷰 배경. 없으면 스플래시가 끝나고 JS 첫 프레임이 그려지기 전까지 시스템 기본 배경(라이트모드=흰색)이 잠깐 보인다(2026-07-28 오너 지적). 스플래시와 같은 색으로 맞춰 이음새를 없앤다. expo-system-ui가 이 값을 네이티브에 반영한다.",
    "backgroundColor": "#0F0F0F",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sodate.app",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": [
          "ko",
          "en"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#EA6491"
      },
      "package": "com.ourmine.sodate",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 5
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B9D"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2792582436871752~3146482592",
          "iosAppId": "ca-app-pub-2792582436871752~7698724284",
          "userTrackingUsageDescription": "회원님께 더 관련성 높은 광고를 제공하기 위해 사용됩니다."
        }
      ],
      "expo-tracking-transparency"
    ],
    "scheme": "sodate",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1b634f2b-480e-4108-b994-c92c3a0dc4b4"
      }
    },
    "owner": "dailyhotcoolmeme",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/1b634f2b-480e-4108-b994-c92c3a0dc4b4",
      "fallbackToCacheTimeout": 8000
    },
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json"
    }
  }
}
